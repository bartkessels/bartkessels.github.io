{
  "name": "bart-kessels-blog",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint 'src/**/*.ts'",
    "test": "vitest run",
    "test:e2e": "pnpm playwright test",
    "new:backpacking/post": "tsx scripts/new-item.ts backpacking-post",
    "new:backpacking/trail": "tsx scripts/new-item.ts backpacking-trail",
    "new:backpacking/section": "tsx scripts/new-item.ts backpacking-section",
    "new:blog/post": "tsx scripts/new-item.ts blog-post",
    "new:blog/subject": "tsx scripts/new-item.ts blog-subject",
    "new:certificate": "tsx scripts/new-item.ts certificate",
    "new:gardening/journal": "tsx scripts/new-item.ts gardening-journal",
    "new:gardening/plant": "tsx scripts/new-item.ts gardening-plant",
    "new:gardening/year": "tsx scripts/new-item.ts gardening-subject",
    "new:software/project": "tsx scripts/new-item.ts software-project",
    "new:story": "tsx scripts/new-item.ts story",
    "check:content": "docker run --rm -v $(pwd):/workspace -w /workspace jdkato/vale content",
    "check:markdown": "markdownlint-cli2 \"content/**/*.{md,mdx}\"",
    "format:content": "prettier --write \"content/**/*.{md,mdx}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.4.1",
    "happy-dom": "^20.10.1",
    "markdownlint-cli2": "^0.22.1",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.22.4",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/mdx": "^6.0.2",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@lucide/astro": "^1.17.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tmcw/togeojson": "^7.1.2",
    "@xmldom/xmldom": "^0.9.10",
    "astro": "^6.4.4",
    "maplibre-gl": "^5.24.0",
    "mermaid": "^11.15.0",
    "playwright": "^1.60.0",
    "rehype-external-links": "^3.0.0",
    "rehype-mermaid": "^3.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
