---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import { MapPin, Ruler, List } from '@lucide/astro';
import { getSectionLabel } from '@/utils/content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContentListItem from '@/components/ContentListItem.astro';
import TagsList from '@/components/TagsList.astro';
import ContentMeta from '@/components/ContentMeta.astro';
import { getBackpackingViewModel } from '@/factories/view-model.factory';
import TrailStatistics from '@/components/TrailStatistics.astro';
import TrailSectionsList from '@/components/TrailSectionsList.astro';
import HeroImage from '@/components/HeroImage.astro';


export const getStaticPaths = (async () => {
    const viewModel = getBackpackingViewModel();
    const pages = await viewModel.getTrailPages();

    return pages.map(page => ({
        params: { trail: page.trail.id },
        props: {
            trail: page.trail,
            distanceInMiles: page.distanceInMiles,
            formattedDate: page.formattedDate,
            sections: page.sections
        },
    }));
}) satisfies GetStaticPaths;

const { trail, formattedDate, distanceInMiles, sections } = Astro.props;
const { Content } = await render(trail);

const sectionLabel = getSectionLabel(sections.length, trail.data.totalSections);
---

<BaseLayout
  title={trail.data.title}
  description={trail.data.description}
  image={trail.data.image}
  activePageId="backpacking">
  <article>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      
      <HeroImage
        imageUrl={trail.data.image}
        alternativeText={trail.data.title}
        caption={trail.data.caption} />

      {/* Header */}
      <header class="mb-8">
        <div class="flex items-center gap-1.5 text-sm text-muted mb-2">
          <MapPin class="h-4 w-4 text-accent" aria-hidden="true" />
          <span>{trail.data.location}, {trail.data.country}</span>
        </div>
        {(trail.data.tags ?? []).length > 0 && (
          <div class="mb-4">
            <TagsList tags={trail.data.tags ?? []} />
          </div>
        )}

        <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-foreground mb-4 leading-tight">
          {trail.data.title}
        </h1>

        <TrailStatistics
          totalDistanceInKm={trail.data.distanceKm}
          totalDistanceInMiles={distanceInMiles}
          walkedSections={trail.data.sections.length}
          totalSections={trail.data.totalSections ?? 0}
        />

        <ContentMeta date={trail.data.date} formattedDate={formattedDate} datePrefix="Started on" />
      </header>

      {/* Content */}
      <div class="prose">
        <Content />
      </div>

      <TrailSectionsList
        trail={trail}
        sections={sections}
      />
    </div>
  </article>
</BaseLayout>
