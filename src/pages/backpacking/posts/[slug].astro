---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import TagsList from '@/components/TagsList.astro';
import ContentMeta from '@/components/ContentMeta.astro';
import { getBackpackingViewModel } from '@/factories/view-model.factory';
import HeroImage from '@/components/HeroImage.astro';

export const getStaticPaths = (async () => {
  const viewModel = getBackpackingViewModel();
  const pages = await viewModel.getPostPages();

  return pages.map(page => ({
    params: { slug: page.post.id },
    props: {
      post: page.post,
      formattedDate: page.formattedDate
    }
  }));
}) satisfies GetStaticPaths;

const { post, formattedDate } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.image}
  activePageId="backpacking"
  tags={post.data.tags}>
  <article>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <HeroImage
        imageUrl={post.data.image}
        alternativeText={post.data.title}
        caption={post.data.caption} />

      <header class="mb-8">
        {(post.data.tags ?? []).length > 0 && (
          <div class="mb-4">
            <TagsList tags={post.data.tags ?? []} />
          </div>
        )}
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-foreground mb-4 leading-tight">
          {post.data.title}
        </h1>
        
        <ContentMeta
          author={post.data.author}
          date={post.data.date}
          formattedDate={formattedDate}
        />
      </header>

      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>
