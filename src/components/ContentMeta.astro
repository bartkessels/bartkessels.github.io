---
import { Calendar, Clock, User } from '@lucide/astro';

interface Props {
  author?: string;
  date: Date;
  formattedDate: string;
  datePrefix?: string;
  readingTime?: number;
}

const { author, date, formattedDate, datePrefix, readingTime } = Astro.props;
---

<div class="flex flex-wrap items-center gap-6 text-sm text-muted border-b border-border pb-6">
  {author && (
    <span class="flex items-center gap-2">
      <User class="h-4 w-4" aria-hidden="true" />
      {author}
    </span>
  )}
  <time datetime={date.toISOString()} class="flex items-center gap-2">
    <Calendar class="h-4 w-4" aria-hidden="true" />
    {datePrefix && `${datePrefix} `}{formattedDate}
  </time>
  {readingTime && (
    <span class="flex items-center gap-2">
      <Clock class="h-4 w-4" aria-hidden="true" />
      {readingTime} min read
    </span>
  )}
</div>
