---
import { Lightbulb } from '@lucide/astro';

interface Props {
    title?: string;
}

const { title = "TL;DR" } = Astro.props;
---

<aside
    class="not-prose my-6 rounded-r-lg border-l-4 border-accent bg-accent/5 px-4 py-3"
    role="note"
    aria-label={title}
>
    <div class="mb-2 flex items-center gap-2">
        <Lightbulb class="h-4 w-4 text-accent" aria-hidden="true" />
        <span class="text-sm font-semibold text-accent/70">{title}</span>
    </div>
    <div class="text-sm leading-relaxed text-foreground/90">
        <slot />
    </div>
</aside>
