---
interface Props {
  image: string;
  imageSide: 'start' | 'end';
  caption: string;
  height?: number;
  title?: string;
}

const { image, imageSide, caption, height = 200, title } = Astro.props;
const classes = imageSide === 'start' ? 'sm:float-start sm:mr-6' : 'sm:float-end sm:ml-6';
---

<div class="my-4">
  {title && <h3 class="sm:hidden mt-1 mb-2">{title}</h3>}
  <div class="clearfix [&>*:first-of-type]:mt-1">
    <figure class:list={['w-full mb-4', 'sm:w-56 sm:mb-2', classes]}>
      <img
        src={image}
        alt={caption}
        style={`height: ${height}px;`}
        class="w-full rounded-t-lg object-cover mb-2"
      />
      <figcaption class="text-center text-xs text-muted italic">
        {caption}
      </figcaption>
    </figure>
    {title && <h3 class="hidden sm:block">{title}</h3>}
    <slot />
  </div>
</div>
