---
/**
 * Thin Astro wrapper around the <trail-map> Web Component.
 * Zero Leaflet knowledge lives here — all map logic is in TrailMapElement.ts.
 * To swap the underlying map library, only TrailMapElement.ts needs to change.
 */
interface Props {
  gpxUrl: string;
  /** Height of the map container (any valid CSS value). Default: 420px */
  height?: string;
  /** Accessible label for the map. Defaults to "Interactive trail map". */
  label?: string;
  /**
   * `card` (default) renders with a rounded border.
   * `hero` renders edge-to-edge with no border or rounding, filling its container.
   */
  variant?: 'card' | 'hero';
}

const { gpxUrl, height = '420px', label = 'Interactive trail map', variant = 'card' } = Astro.props;
const mapClass = variant === 'hero'
  ? 'block w-full h-full'
  : 'block w-full rounded-xl border border-border overflow-hidden my-8';
---

<trail-map
  gpx={gpxUrl}
  role="img"
  aria-label={label}
  class={mapClass}
  style={`height: ${height};`}
>
  <p class="sr-only">
    Interactive map showing the trail route. Enable JavaScript and a modern browser to view.
  </p>
</trail-map>

<script>
  import '@/components/TrailMapElement';
</script>

