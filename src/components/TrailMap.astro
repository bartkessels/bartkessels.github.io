---
import { getGpxManager } from '@/factories/manager-factory';
import 'maplibre-gl/dist/maplibre-gl.css';
import { gpx } from '@tmcw/togeojson';
import { DOMParser } from '@xmldom/xmldom';

interface Props {
  gpxUrl: string;
  height?: string;
  label?: string;
}

const gpxManager = getGpxManager();
const { gpxUrl, height = '420px', label = 'Interactive trail map' } = Astro.props;

const rawGpx = await gpxManager.getRawGpx(gpxUrl);
const gpxDoc = new DOMParser().parseFromString(rawGpx, 'text/xml');
const geojson = gpx(gpxDoc);

const coords = (geojson.features as GeoJSON.Feature[]).flatMap((f) => {
  if (f.geometry.type === 'LineString') return f.geometry.coordinates;
  if (f.geometry.type === 'MultiLineString') return f.geometry.coordinates.flat();
  return [];
}) as [number, number][];

const bounds: [[number, number], [number, number]] | null = coords.length > 0
  ? coords.reduce(
      (b, c) => [[Math.min(b[0][0], c[0]), Math.min(b[0][1], c[1])], [Math.max(b[1][0], c[0]), Math.max(b[1][1], c[1])]],
      [[coords[0][0], coords[0][1]], [coords[0][0], coords[0][1]]] as [[number, number], [number, number]]
    )
  : null;
---

<div
  data-trail-map
  data-geojson={JSON.stringify(geojson)}
  data-bounds={JSON.stringify(bounds)}
  role="img"
  aria-label={label}
  class="block w-full rounded-xl border border-border overflow-hidden my-8"
  style={`height: ${height};`}
>
  <p class="sr-only">
    Interactive map showing the trail route. Enable JavaScript and a modern browser to view.
  </p>
</div>

<script>
  import maplibregl from 'maplibre-gl';

  // Astro deduplicates this script, so one execution initialises all trail maps.
  document.querySelectorAll<HTMLElement>('[data-trail-map]').forEach((el) => {
    const geojson = JSON.parse(el.dataset.geojson!) as GeoJSON.FeatureCollection;
    const bounds = el.dataset.bounds ? JSON.parse(el.dataset.bounds) as [[number, number], [number, number]] | null : null;

    const map = new maplibregl.Map({
      container: el,
      // OpenFreeMap "liberty" style — vector tiles, no API key, no tracking.
      style: '/openfreemap/tiles/liberty.json',
      scrollZoom: true,
      attributionControl: { compact: true },
    });

    map.once('load', () => {
      map.addSource('trail', { type: 'geojson', data: geojson });

      map.addLayer({
        id: 'trail-casing',
        type: 'line',
        source: 'trail',
        layout: { 'line-join': 'round', 'line-cap': 'round' },
        paint: { 'line-color': '#fff', 'line-width': 7, 'line-opacity': 0.6 },
      });

      map.addLayer({
        id: 'trail-line',
        type: 'line',
        source: 'trail',
        layout: { 'line-join': 'round', 'line-cap': 'round' },
        paint: { 'line-color': '#e05d12', 'line-width': 4, 'line-opacity': 0.95 },
      });

      if (bounds) {
        map.fitBounds(bounds, { padding: 40, animate: true });
      }
    });
  });
</script>

